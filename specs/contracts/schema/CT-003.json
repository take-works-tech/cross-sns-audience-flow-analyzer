{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CT-003 ProjectDocument",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project_id", "nodes", "manual_edges", "thresholds", "filters", "period", "node_groups"],
  "properties": {
    "version": { "const": "1.0.0" },
    "project_id": { "type": "string", "format": "uuid" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "position"],
        "properties": {
          "node_id": { "type": "string", "format": "uuid" },
          "position": { "$ref": "#/$defs/position" }
        }
      }
    },
    "manual_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_node_id", "target_node_id", "kind", "auto_update"],
        "properties": {
          "source_node_id": { "type": "string", "format": "uuid" },
          "target_node_id": { "type": "string", "format": "uuid" },
          "kind": { "enum": ["assist", "pinned"] },
          "auto_update": { "type": "boolean" },
          "thresholds": { "$ref": "#/$defs/thresholds" },
          "period": { "$ref": "#/$defs/period" }
        }
      }
    },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": { "type": "array", "items": { "enum": ["youtube", "instagram", "tiktok", "x"] } },
        "node_kinds": { "type": "array", "items": { "enum": ["account", "post", "video", "generic", "product", "site-top"] } },
        "flow_types": { "type": "array", "items": { "enum": ["observed", "estimated"] } }
      }
    },
    "period": { "$ref": "#/$defs/period" },
    "node_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "label", "node_ids"],
        "properties": {
          "group_id": { "type": "string" },
          "label": { "type": "string" },
          "node_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_count": { "type": "integer", "minimum": 0 },
        "min_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
