{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cckit/secrets-schema/cross-sns-audience-flow-analyzer.json",
  "title": "cross-sns-audience-flow-analyzer required environment variables",
  "description": "Declares which environment variables the application requires at startup. The app must validate this schema on boot and fail loudly (No Silent Fallback) when a required key is missing or has the wrong type.",
  "type": "object",
  "properties": {
    "LOG_LEVEL": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"],
      "required": false
    },
    "NODE_ENV": {
      "type": "string",
      "enum": ["development", "test", "production"],
      "required": false
    },
    "API_BASE_URL": {
      "type": "string",
      "format": "uri",
      "required": true
    },
    "DATABASE_URL": {
      "type": "string",
      "format": "uri",
      "required": true
    },
    "JWT_SECRET": {
      "type": "string",
      "minLength": 32,
      "required": true,
      "secret": true
    },
    "JWT_EXPIRES_IN": {
      "type": "integer",
      "minimum": 60,
      "required": false
    }
  },
  "additionalProperties": true
}
