# cross-sns-audience-flow-analyzer — Environment Variables Template
#
# Copy this file to `.env` and fill in the values.
# WARNING: NEVER commit `.env` to version control. It is listed in `.gitignore`.
# Secrets in commits must be rotated immediately.

# --- Application ---
LOG_LEVEL=info
NODE_ENV=development

# --- API / Networking ---
# Base URL the frontend uses to reach the backend (no trailing slash).
API_BASE_URL=http://localhost:8000

# --- Database ---
# Example: postgres://user:password@localhost:5432/dbname
DATABASE_URL=

# --- Authentication ---
# JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=
# Token lifetime (seconds).
JWT_EXPIRES_IN=3600

# --- Third-party services (optional; remove what you do not use) ---
# SENTRY_DSN=
# REDIS_URL=
# SMTP_URL=

# --- Cloud / Object Storage (optional) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=

# Validation: a schema in `.secrets-schema.json` declares which of the above are
# required at startup. Missing required keys must fail loudly (No Silent Fallback).
